# DuctTapeHook Configuration
# Copy this file to config.env and update with your actual values

# Authentication token - generate with: openssl rand -hex 32
# IMPORTANT: Keep this secret and never commit config.env to version control!
WEBHOOK_AUTH_TOKEN=your_secret_token_here

# Port to listen on (default: 2000)
WEBHOOK_PORT=2000

# Full path to the scripts directory
# Example: /home/webhook/duct-tape-hook/scripts
SCRIPTS_PATH=/full/path/to/your/scripts
